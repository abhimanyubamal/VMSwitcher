<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VM Switcher" Width="1180" Height="940" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#0B1220" FontFamily="Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#111A2E"/>
    <SolidColorBrush x:Key="Line" Color="#1E2A44"/>
    <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>

    <Style x:Key="OptBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#F1F5F9"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="#16213A" BorderBrush="#24324F" BorderThickness="1" CornerRadius="12" Padding="14,10">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1D2B4A"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#38BDF8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#0E7490"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                <Setter Property="Cursor" Value="No"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SmallBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#F1F5F9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#38BDF8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#CBD5E1"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="B" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="16,8" Margin="0,0,4,0">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#38BDF8"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#0F172A"/>
      <Setter Property="Foreground" Value="#E2E8F0"/>
      <Setter Property="RowBackground" Value="#0F172A"/>
      <Setter Property="AlternatingRowBackground" Value="#111A2E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#1E2A44"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="AutoGenerateColumns" Value="True"/>
      <Setter Property="ColumnWidth" Value="Auto"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#16213A"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="BorderBrush" Value="#1E2A44"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1E3A5F"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="Critical"><Setter Property="Background" Value="#3B1C22"/></DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Background" Value="#33290F"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="18,12,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- header -->
      <RowDefinition Height="Auto"/>  <!-- alert strip -->
      <RowDefinition Height="Auto"/>  <!-- banner -->
      <RowDefinition Height="Auto"/>  <!-- cards -->
      <RowDefinition Height="Auto"/>  <!-- demo -->
      <RowDefinition Height="Auto"/>  <!-- options -->
      <RowDefinition Height="Auto"/>  <!-- status line -->
      <RowDefinition Height="320"/>   <!-- history -->
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="4,0,4,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="VM Switcher" FontSize="26" FontWeight="Bold" Foreground="White"/>
          <Border x:Name="DemoBadge" Visibility="Collapsed" Background="#7C3AED" CornerRadius="6" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="DEMO MODE - simulated VMs" Foreground="White" FontWeight="Bold" FontSize="12"/>
          </Border>
        </StackPanel>
        <TextBlock x:Name="ThisServer" Text="This server: ..." FontSize="14" Foreground="#7DD3FC" Margin="1,0,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="PeerPill" CornerRadius="14" Padding="12,5" Background="#334155" Margin="0,0,8,0">
          <TextBlock x:Name="PeerText" Text="Other server: checking..." Foreground="White" FontSize="13" FontWeight="SemiBold"/>
        </Border>
        <Border x:Name="WdPill" CornerRadius="14" Padding="12,5" Background="#14532D" Margin="0,0,8,0">
          <TextBlock x:Name="WdText" Text="Watchdog: checking..." Foreground="White" FontSize="13" FontWeight="SemiBold"/>
        </Border>
        <Border x:Name="AfPill" CornerRadius="14" Padding="12,5" Background="#14532D" Margin="0,0,12,0">
          <TextBlock x:Name="AfText" Text="Auto-failover: ..." Foreground="White" FontSize="13" FontWeight="SemiBold"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Clock" Foreground="#E2E8F0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          <TextBlock x:Name="LastCheck" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Alert strip: stays until someone clicks "Got it" -->
    <Border Grid.Row="1" x:Name="AlertStrip" Visibility="Collapsed" Background="#7F1D1D" BorderBrush="#F87171" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="4,0,4,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#x26A0;" FontSize="30" Foreground="#FECACA" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="AlertTitle" FontSize="17" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="AlertText" FontSize="14" Foreground="#FEE2E2" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="2" x:Name="AlertAck" Style="{StaticResource SmallBtn}" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="Got it" FontSize="15" FontWeight="SemiBold"/>
        </Button>
      </Grid>
    </Border>

    <!-- Banner: one plain sentence -->
    <Border Grid.Row="2" x:Name="Banner" CornerRadius="12" Padding="18,12" Margin="4,0,4,8" Background="#052E1A" BorderBrush="#166534" BorderThickness="1">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="BannerIcon" DockPanel.Dock="Left" Text="&#x2714;" FontSize="24" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock x:Name="BannerText" Text="Checking the virtual machines..." FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- VM cards -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!--CARD_P-->
      <!--CARD_S-->
    </Grid>

    <!-- Demo / fire drill panel (simulated mode only) -->
    <Border Grid.Row="4" x:Name="DemoPanel" Visibility="Collapsed" Background="#1E1B4B" BorderBrush="#4C1D95" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="8,4,8,4">
      <StackPanel>
        <TextBlock Text="FIRE DRILL (demo mode only): make something go wrong and watch the watchdog react." Foreground="#DDD6FE" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <WrapPanel>
          <Button x:Name="Demo_CrashP" Style="{StaticResource SmallBtn}" Margin="0,0,8,0"><TextBlock Text="Crash the Primary"/></Button>
          <Button x:Name="Demo_FreezeP" Style="{StaticResource SmallBtn}" Margin="0,0,8,0"><TextBlock Text="Freeze the Primary (no heartbeat)"/></Button>
          <Button x:Name="Demo_FixP" Style="{StaticResource SmallBtn}" Margin="0,0,8,0"><TextBlock Text="Un-freeze the Primary"/></Button>
          <Button x:Name="Demo_CrashS" Style="{StaticResource SmallBtn}" Margin="0,0,8,0"><TextBlock Text="Crash the Secondary"/></Button>
          <Button x:Name="Demo_Cut" Style="{StaticResource SmallBtn}" Margin="0,0,8,0"><TextBlock x:Name="Demo_CutText" Text="Cut the network to the other server"/></Button>
          <Button x:Name="Demo_Reset" Style="{StaticResource SmallBtn}" Margin="0,0,8,0"><TextBlock Text="Reset: Primary ON, Secondary OFF"/></Button>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Options 1..9 -->
    <UniformGrid Grid.Row="5" Columns="3" Margin="2,6,2,0">
      <!--BUTTONS-->
    </UniformGrid>

    <!-- Working / result line -->
    <Border Grid.Row="6" Margin="8,8,8,8" CornerRadius="10" Background="#0F172A" Padding="14,8" BorderBrush="#1E2A44" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="ResultText" Text="Click a numbered button, or press 1-9 on the keyboard." Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"/>
          <ProgressBar x:Name="Busy" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,6,0,0" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"/>
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="UserText" Foreground="#475569" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>
    </Border>

    <!-- History -->
    <Border Grid.Row="7" Background="{StaticResource Card}" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="8,0,8,0" Padding="8">
      <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
        <TabItem Header="What happened"><DataGrid x:Name="GridEvents"/></TabItem>
        <TabItem Header="VM hand-offs"><DataGrid x:Name="GridHandoffs"/></TabItem>
        <TabItem Header="Actions by people"><DataGrid x:Name="GridMine"/></TabItem>
        <TabItem Header="Light changes"><DataGrid x:Name="GridChanges"/></TabItem>
      </TabControl>
    </Border>
  </Grid>
  </ScrollViewer>
</Window>
